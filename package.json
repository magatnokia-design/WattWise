  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "verify:functions": "npm --prefix functions run lint && npm --prefix functions test",
    "device:qr": "node scripts/generate-device-qr.js",
    "lint:app": "node functions/node_modules/eslint/bin/eslint.js src --ext .js",
