{
    "permissions":  {
                        "allow":  [
                                      "Bash(npm test *)",
                                      "Bash(npm run lint *)",
                                      "Bash(npm run *)",
                                      "Bash(npx expo start *)",
                                      "Bash(npx expo export *)",
                                      "Bash(firebase deploy --only functions*)",
                                      "Bash(firebase emulators:start*)",
                                      "Bash(git status)",
                                      "Bash(git diff *)",
                                      "Bash(git log *)",
                                      "Bash(git branch *)",
                                      "Bash(git add *)",
                                      "Bash(git commit *)"
                                  ],
                        "deny":  [
                                     "Bash(firebase deploy --only firestore:rules*)",
                                     "Bash(firebase deploy --only firestore*)",
                                     "Bash(git push --force*)",
                                     "Bash(git reset --hard*)",
                                     "Bash(rm -rf *)",
                                     "Bash(rm -fr *)",
                                     "Bash(git clean *)",
                                     "Bash(arduino-cli lib upgrade*)",
                                     "Bash(npm audit fix --force*)"
                                 ]
                    },
    "hooks":  {
                  "PostToolUse":  [
                                      {
                                          "hooks":  [
                                                        {
                                                            "command":  "powershell -File .claude\\hooks\\post-edit-check.ps1",
                                                            "type":  "command"
                                                        }
                                                    ],
                                          "matcher":  "Write|Edit"
                                      }
                                  ]
              }
}
