{
	"files.associations": {
		"*.ino": "cpp"
	},

	// Kept in step with .vscode/c_cpp_properties.json. Both once pointed at ESP32
	// core 2.0.14 and at a hardcoded C:/Users/IDEAPAD/... path. c_cpp_properties
	// was fixed then; this file was not, so it still resolved nothing and every
	// Arduino include went red, the errors spreading into the headers the sketch
	// pulls in, secrets.h among them.
	//
	// Both files now use ${env:LOCALAPPDATA} and a * for the core version, so
	// neither is tied to one machine or one core release.
	"C_Cpp.default.includePath": [
		"${workspaceFolder}/**",
		"${env:LOCALAPPDATA}/Arduino15/libraries/**",
		"${env:LOCALAPPDATA}/Arduino15/packages/esp32/hardware/esp32/*/cores/esp32",
		"${env:LOCALAPPDATA}/Arduino15/packages/esp32/hardware/esp32/*/libraries/**",
		"${env:LOCALAPPDATA}/Arduino15/packages/esp32/hardware/esp32/*/variants/esp32",
		"${env:LOCALAPPDATA}/Arduino15/packages/esp32/tools/esp32-libs/*/include/**"
	],
	"C_Cpp.default.defines": [
		"ARDUINO=10607",
		"ESP32",
		"ARDUINO_ARCH_ESP32"
	],
	"C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
	"C_Cpp.default.cppStandard": "c++17",
	"C_Cpp.default.cStandard": "c11"
}
