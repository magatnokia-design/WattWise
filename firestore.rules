rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===========================
    // HELPER FUNCTIONS
    // ===========================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidOutletInitPayload() {
      return request.resource.data.keys().hasOnly([
        'outletNumber',
        'status',
        'applianceName',
        'voltage',
        'current',
        'power',
        'energy',
        'totalEnergy',
        'lastUpdated',
        'autoDetectedAppliance'
      ]);
    }

    // Device mapping docs used by Cloud Functions to resolve ESP32 ownership.
    //
    // A HUB IS RELEASED, NEVER DELETED
    //
    // `create` can only ask that the writer names themselves as the owner - a
    // rule cannot check a device token, because it cannot see a secret. So a
    // missing document is a claimable one: any signed-in account that guessed
    // the deviceId could take it, and `ESP32_ROOM_A` is printed in the paper.
    //
    // Deleting is therefore denied outright, and unlinking removes the `userId`
    // instead (see src/utils/deviceRelease.js). The document always exists, so
    // `create` never applies to hardware that has been paired even once, and
    // the window closes. Cloud Functions use the Admin SDK and bypass all of
    // this; `deleteAccount` already released rather than deleted.
    match /devices/{deviceId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // An owner may keep the device, or let it go by removing `userId`.
      // Nothing else: rewriting `userId` to another account is a handover, and
      // handovers go through linkDeviceToAccount, which checks the token.
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && (
                      request.resource.data.userId == request.auth.uid
                      || !('userId' in request.resource.data)
                    );

      // STILL PERMITTED, AND IT SHOULD NOT BE - deliberately, for one release.
      //
      // `allow delete: if false` is the end state and closes the window for
      // good. It cannot go in yet: clients already installed (app 1.1.31, the
      // deployed web) still call deleteDoc here, and denying it would break
      // Remove Device on hardware people are holding. Rules apply the moment
      // they are deployed; a client update does not.
      //
      // So: release lands in the clients first, then this line becomes
      // `if false` in the release after. Until then the deletion path exists
      // but nothing walks it.
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ===========================
    // USERS COLLECTION
    // ===========================
    
    match /users/{userId} {
      // Users can read/write their own profile
      allow read, write: if isOwner(userId);
      
      // ===========================
      // OUTLETS SUBCOLLECTION
      // ===========================
      match /outlets/{outletId} {
        // Users can read outlets, initialize outlet docs, and rename appliances.
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidOutletInitPayload();
        allow update: if isOwner(userId)
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['applianceName', 'lastUpdated', 'outletNumber']);
        allow delete: if false;
      }
      
      // ===========================
      // HISTORY_LOGS SUBCOLLECTION
      // ===========================
      match /history_logs/{logId} {
        // 🔒 LOCKED: Users can only READ
        allow read: if isOwner(userId);
        allow write: if false;  // Only Cloud Functions can write
      }
      
      // ===========================
      // HISTORY_DAILY SUBCOLLECTION
      // ===========================
      match /history_daily/{date} {
        // 🔒 LOCKED: Users can only READ
        allow read: if isOwner(userId);
        allow write: if false;  // Only Cloud Functions can write
      }
      
      // ===========================
      // INVOICES SUBCOLLECTION
      // ===========================
      match /invoices/{billingMonth} {
        // Read-only. Invoices are built and finalized server-side so a client
        // can never alter a billed figure; finalizing goes through the
        // finalizeInvoice callable.
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // ===========================
      // SCHEDULES SUBCOLLECTION
      // ===========================
      match /schedules/{scheduleId} {
        // ✅ OPEN: Users can fully manage their schedules
        allow read, write: if isOwner(userId);
      }
      
      // ===========================
      // BUDGET SUBCOLLECTION
      // ===========================
      match /budget/{month} {
        // Users can manage their own monthly budget documents.
        allow read, write: if isOwner(userId);
      }
      
      // ===========================
      // NOTIFICATIONS SUBCOLLECTION
      // ===========================
      match /notifications/{notificationId} {
        // Users can read notifications; create is allowed for in-app manual/testing notifications.
        allow read: if isOwner(userId);
        
        allow create: if isOwner(userId);
        
        // Users can ONLY update the 'read' field (mark as read)
        allow update: if isOwner(userId) && 
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        
        // Users can DELETE their own notifications
        allow delete: if isOwner(userId);
      }

      // ===========================
      // DEVICE_COMMANDS SUBCOLLECTION
      // ===========================
      match /device_commands/{commandId} {
        // Users can inspect command lifecycle; writes remain server-side only.
        allow read: if isOwner(userId);
        allow write: if false;
      }
      
      // ===========================
      // POWER_SAFETY SUBCOLLECTION
      // ===========================
      match /power_safety/{document=**} {
        // ✅ OPEN: Users can read and write power safety settings
        allow read, write: if isOwner(userId);
      }
      
      // ===========================
      // REFERENCE_COMPARISON SUBCOLLECTION
      // ===========================
      match /reference_comparison/{month} {
        // ✅ OPEN: Users can fully manage their reference bills
        allow read, write: if isOwner(userId);
      }

      // Security event log. Readable by its owner so they can see what happened
      // to their own account; writable by nobody.
      //
      // `allow write: if false` is the whole value of an audit log: an actor who
      // could add entries could forge an alibi, and one who could delete them
      // could erase the record of what they did. Cloud Functions write these
      // through the Admin SDK, which bypasses these rules.
      match /security_events/{eventId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Rate-limit counters, written only by Cloud Functions through the Admin
    // SDK, which bypasses these rules entirely.
    //
    // Firestore already denies anything no rule matches, so this block changes
    // nothing today. It is here because a client that could read these would
    // learn how close it is to a limit, and one that could write them could
    // reset its own counter - which is the whole defence. Stating it means a
    // later broadening of the rules cannot expose them by accident.
    match /rate_limits/{limitId} {
      allow read, write: if false;
    }
  }
}