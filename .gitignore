# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example
.env*.local

# firebase extension secret pointers (written by `firebase deploy --only extensions`)
extensions/*.secret.local

# device / service credentials - never commit
secrets.h
# generated pairing QR codes embed the device token
docs/esp32/qr/
google-services.json
GoogleService-Info.plist
*serviceAccount*.json
*firebase-adminsdk*.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
