# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example
.env*.local

# firebase extension secret pointers (written by `firebase deploy --only extensions`)
extensions/*.secret.local

# device / service credentials - never commit
secrets.h
# generated pairing QR codes embed the device token
docs/esp32/qr/
# google-services.json is deliberately NOT ignored: expo.android.googleServicesFile
# points at it, EAS builds from git, and an ignored file never reaches the build -
# which silently breaks FCM registration. It holds public identifiers only.
GoogleService-Info.plist
*serviceAccount*.json
*firebase-adminsdk*.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase CLI debug output
firebase-debug.log
firebase-debug.*.log
functions/firebase-debug.log

# The Hub booklet carries the device token, AP password and pairing QR for the
# unit it ships with. Those are credentials, both repos are public, and this
# token has been exposed in commit history once already. Kept on disk, never
# committed - regenerate the QR with `npm run device:qr` after any rotation.
docs/hub-setup-booklet.html
